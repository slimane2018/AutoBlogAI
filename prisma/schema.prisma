generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  email              String    @unique
  name               String?
  image              String?
  stripeCustomerId   String?   // for subscriptions
  role               UserRole  @default(USER)
  projects           Project[]
  neuronWriterTokens NeuronWriterAccount[]
  websites           Website[]
  settings           Settings?
  // NextAuth relations (if using prisma adapter)
  accounts           Account[]
  sessions           Session[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  keywords    Keyword[]
  settings    ProjectSettings?
  websites    Website[] // websites connected to this project
}

model Website {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  name               String?
  siteUrl            String
  username           String
  applicationPassword String // ENCRYPTED at rest (see notes)
  verified           Boolean @default(false)
  user               User    @relation(fields: [userId], references: [id])
  userId             String
  project            Project? @relation(fields: [projectId], references: [id])
  projectId          String?
  postsFetchedAt     DateTime?
  posts              WordpressPost[]  // local cache of WP posts
  publishingLogs     PublishingLog[]
}

model NeuronWriterAccount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  apiKey    String   // encrypt at rest
  name      String?
  briefs    Brief[]
}

model Keyword {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  keyword      String
  project      Project   @relation(fields: [projectId], references: [id])
  projectId    String
  status       PipelineStatus @default(KEYWORD_ADDED)
  briefs       Brief[]
  outline      Outline?
  article      Article?
  schedule     Schedule?
  attemptedAt  DateTime?
  metadata     Json?
}

model Brief {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  neuronWriterId     String   @unique
  keyword            Keyword  @relation(fields: [keywordId], references: [id])
  keywordId          String
  targetKeyword      String?
  nlpTerms           Json?    // array of NLP terms
  competitorHeadings Json?
  recommendedWords   Int?
  searchIntent       String?
  questions          Json?
  internalLinks      Json?
  rawResponse        Json
}

model Outline {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  keyword      Keyword  @relation(fields: [keywordId], references: [id])
  keywordId    String
  sections     Json     // array of {heading, brief, wordTarget}
  readTime     Int?
}

model Article {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  title          String
  seoTitle       String?
  slug           String    @unique
  metaDescription String?
  content        String    // full HTML content
  wordCount      Int
  readability    Int
  status         ArticleStatus @default(DRAFT)
  sourceOutline  Outline? @relation(fields: [outlineId], references: [id])
  outlineId      String?
  keyword        Keyword  @relation(fields: [keywordId], references: [id])
  keywordId      String
  website        Website  @relation(fields: [websiteId], references: [id])
  websiteId      String
  images         Image[]
  internalLinks  Json? // array of {url, anchor}
  seoScore       Int?
  publishingLog  PublishingLog?
}

model Image {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  url         String
  alt         String?
  caption     String?
  provider    ImageProvider
  article     Article? @relation(fields: [articleId], references: [id])
  articleId   String?
  wordpressMediaId String? // remote id
}

model Schedule {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id])
  projectId      String
  frequency      ScheduleFrequency
  nextRunAt      DateTime
  preferences    Json?
}

model PublishingLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id])
  articleId   String
  website     Website  @relation(fields: [websiteId], references: [id])
  websiteId   String
  status      PublishingStatus
  remoteId    String?
  message     String?
  response    Json?
}

model WordpressPost {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  website       Website   @relation(fields: [websiteId], references: [id])
  websiteId     String
  remoteId      String    // WP post ID
  title         String
  url           String
  excerpt       String?
  publishedAt   DateTime?
  cachedContent String?
  vector        Float[]?  // optional if using pgvector you may map this to vector type
}

model Embedding {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sourceType  EmbeddingSource
  sourceId    String    // e.g., WordpressPost.remoteId or Article.id
  vector      Float[]   // store via pgvector in Postgres or use external vector DB
  metadata    Json?
}

model JobQueue {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  type       String
  payload    Json
  attempts   Int      @default(0)
  status     String
  lastError  String?
}

model Settings {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique
  preferences Json?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?   @db.Text
  access_token       String?   @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?   @db.Text
  session_state      String?
  user               User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  USER
  ADMIN
}

enum PipelineStatus {
  KEYWORD_ADDED
  BRIEF_RETRIEVED
  OUTLINE_CREATED
  ARTICLE_GENERATED
  REVIEW
  PUBLISHED
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  FAILED
}

enum ImageProvider {
  OPENAI
  PIXABAY
  PEXELS
  UPLOADED
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum PublishingStatus {
  PENDING
  SUCCESS
  FAILED
}

enum EmbeddingSource {
  WORDPRESS_POST
  ARTICLE
  KEYWORD
}
